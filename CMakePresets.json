{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "dev",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "EIME_BUILD_TOOLS": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "EIME_ENABLE_DIAGNOSTICS": "OFF"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "EIME_BUILD_TOOLS": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "EIME_ENABLE_DIAGNOSTICS": "OFF"
      }
    },
    {
      "name": "mingw-dev",
      "inherits": "dev",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "mingw-release",
      "inherits": "release",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "msvc-dev",
      "inherits": "dev",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    },
    {
      "name": "msvc-release",
      "inherits": "release",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    },
    {
      "name": "diagnostic",
      "hidden": true,
      "inherits": "dev",
      "cacheVariables": {
        "EIME_ENABLE_DIAGNOSTICS": "ON"
      }
    },
    {
      "name": "msvc-diagnostic",
      "inherits": [
        "diagnostic",
        "msvc-dev"
      ]
    },
    {
      "name": "mingw-diagnostic",
      "inherits": [
        "diagnostic",
        "mingw-dev"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "mingw-dev",
      "configurePreset": "mingw-dev",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "mingw-release",
      "configurePreset": "mingw-release",
      "configuration": "Release"
    },
    {
      "name": "msvc-dev",
      "configurePreset": "msvc-dev",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release",
      "configuration": "Release"
    },
    {
      "name": "msvc-diagnostic",
      "configurePreset": "msvc-diagnostic",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "mingw-diagnostic",
      "configurePreset": "mingw-diagnostic",
      "configuration": "RelWithDebInfo"
    }
  ],
  "testPresets": [
    {
      "name": "mingw-dev",
      "configurePreset": "mingw-dev",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "msvc-dev",
      "configurePreset": "msvc-dev",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "msvc-diagnostic",
      "configurePreset": "msvc-diagnostic",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "mingw-diagnostic",
      "configurePreset": "mingw-diagnostic",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}

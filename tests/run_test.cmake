cmake_minimum_required(VERSION 3.20)

foreach(required TEST_EXE TEST_NAME TEST_ROOT DICT)
    if (NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(runtime "${TEST_ROOT}/${TEST_NAME}-${nonce}")
file(MAKE_DIRECTORY "${runtime}/data" "${runtime}/build")
file(COPY "${DICT}" DESTINATION "${runtime}/data")
set(arguments "")
if (DEFINED TEST_DLL)
    set(staged_dll "${runtime}/build/eime_tip.dll")
    configure_file("${TEST_DLL}" "${staged_dll}" COPYONLY)
    set(ENV{EIME_TEST_DLL} "${staged_dll}")
    if (NEEDS_DLL_ARG)
        list(APPEND arguments "${staged_dll}")
    endif()
endif()
execute_process(COMMAND "${TEST_EXE}" ${arguments}
    WORKING_DIRECTORY "${runtime}" RESULT_VARIABLE result TIMEOUT 110)
if (NOT result STREQUAL "0")
    message(FATAL_ERROR "${TEST_NAME} failed (${result}); evidence: ${runtime}")
endif()

# Delete only the newly created invocation directory beneath this build's root.
file(REAL_PATH "${TEST_ROOT}" root_real)
file(REAL_PATH "${runtime}" runtime_real)
cmake_path(IS_PREFIX root_real "${runtime_real}" NORMALIZE inside_root)
if (NOT inside_root OR runtime_real STREQUAL root_real)
    message(FATAL_ERROR "Refusing to clean unexpected test path: ${runtime_real}")
endif()
file(REMOVE_RECURSE "${runtime_real}")
